+html[data-reader] .doc article :is(h1, h2, h3, h4):first-child { margin-top: 0; }
+html[data-reader] .doc article [data-rd-num]::before { content: attr(data-rd-num) " "; margin-right: 0.35em; font-family: var(--font-mono); font-size: 0.62em; font-weight: 500; letter-spacing: 0; color: var(--ink-dim); white-space: nowrap; }
+
