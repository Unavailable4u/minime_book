+
+/* inline code and code blocks */
+html[data-reader] .doc article :not(pre) > code { font-family: var(--font-mono); font-variant-ligatures: none; font-size: 0.84em; color: var(--ink); background: var(--panel-2); border: 1px solid var(--line); border-radius: var(--radius-1); padding: 0.08em 0.36em; overflow-wrap: anywhere; hyphens: none; }
+html[data-reader] .doc article pre { margin: 0; padding: var(--space-3) var(--space-4); font-family: var(--font-mono); font-variant-ligatures: none; font-size: 0.8em; line-height: 1.55; tab-size: 4; color: var(--ink); background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius-2); }
+html[data-reader] .doc article pre code { font-size: inherit; color: inherit; background: none; border: 0; padding: 0; }
+html[data-reader] .rd-pre { position: relative; margin: 1.3em 0; }
