+}
+html[data-reader] .doc article h1 { margin-top: 2.6em; margin-bottom: 0.6em; padding-bottom: 0.3em; border-bottom: 1px solid var(--line); font-size: calc(var(--rd-fs) * 1.85); font-weight: 700; letter-spacing: -0.02em; }
+html[data-reader] .doc article h2 { margin-top: 2.1em; margin-bottom: 0.55em; padding-bottom: 0.25em; border-bottom: 1px solid var(--line); font-size: calc(var(--rd-fs) * 1.42); }
+html[data-reader] .doc article h3 { margin-top: 1.8em; margin-bottom: 0.45em; font-size: calc(var(--rd-fs) * 1.16); }
