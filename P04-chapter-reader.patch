+html[data-reader] .rd-anchor { position: absolute; left: -1.5em; top: 50%; display: inline-flex; align-items: center; justify-content: center; width: 1.2em; height: 1.2em; margin-top: -0.6em;
+  color: var(--ink-dim); opacity: 0; text-decoration: none; border-radius: var(--radius-1); transition: opacity var(--dur-1) var(--ease); }
+html[data-reader] :is(h1, h2, h3, h4):is(:hover, :focus-within) > .rd-anchor, html[data-reader] .rd-anchor:focus-visible { opacity: 1; }
