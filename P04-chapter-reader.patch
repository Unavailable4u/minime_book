+/* MiniMe Atlas 2 - chapter reader layer (P04). Loaded by assets/js/reader.js, AFTER the page's own inline CSS and shell.css.
+
+   Every rule is scoped under html[data-reader], which reader.js sets only once it has run: until then the page looks
+   exactly as it did, and with ?legacy=1 (no shell, no reader) it stays that way. The old chapter CSS uses simple selectors
+   (.doc article, .toc a, ...) and a few !important mobile rules for the contents drawer; the selectors here are more
+   specific on purpose, and the !important ones are matched only where an old !important has to be beaten.
+
+   Tokens only (tokens.css). Raw colours appear only inside @media print, where the page is forced to white paper.
+
+   Layout, wide screens:     [ sidebar ][ ...... article track (~100ch) ...... ][ On this page ]
+                                         text column ~72ch, centred in the track;
+                                         tables and code use the whole track (they "bleed" evenly on both sides)
+   Below 1200px:             no side rail; "On this page" is a bottom sheet opened by the top bar's Contents button. */
+
+/* ============================================================ 1. frame */
+html[data-reader] {
+  --rd-fs: 1.08rem;                                       /* prose size; reader.js overrides it with the saved Aa choice */
+  --rd-bar-h: 38px;                                       /* the chapter bar */
+  --rd-bar-top: 0px;                                      /* ...counted in only while the bar is showing (html[data-rdbar]) */
+  --rd-measure: calc(var(--rd-fs) * 36);                  /* ~72 characters of the serif face */
+  --rd-wide: calc(var(--rd-fs) * 50);                     /* ~100 characters: the track that tables and code may use */
+  --rd-head-w: calc(var(--rd-wide) + var(--toc-w) + var(--space-7));
+  scroll-padding-top: calc(var(--topbar-h) + var(--rd-bar-h) + 12px);
+}
+html[data-reader][data-rdbar] { --rd-bar-top: var(--rd-bar-h); }
+@media (max-width: 1199px) { html[data-reader] { --rd-head-w: var(--rd-wide); } }
+@media (prefers-reduced-motion: reduce) { html[data-reader] { scroll-behavior: auto; } }
+
+html[data-reader] main.rd-main { max-width: none; padding: var(--space-6) clamp(var(--space-4), 3vw, var(--space-7)) var(--space-8); }
+html[data-reader] main.rd-main--doc > :is(h1, .sub, .bk-banner, .bk-override-box) { max-width: var(--rd-head-w); margin-inline: auto; }
+
+html[data-reader] .doc { display: grid; grid-template-columns: minmax(0, var(--rd-wide)) var(--toc-w); column-gap: var(--space-7); justify-content: center; align-items: start; }
+@media (max-width: 1199px) { html[data-reader] .doc { grid-template-columns: minmax(0, var(--rd-wide)); } }
+html[data-reader][data-toc="closed"] .doc { grid-template-columns: minmax(0, var(--rd-wide)); }
+@media (min-width: 1200px) { html[data-reader][data-toc="closed"] .doc > .toc { display: none; } }
+
+/* the old per-page progress bar is replaced by .rd-progress */
+html[data-reader] .bk-progress { display: none; }
+
+/* chapter pages have no .mm wrapper, so base.css's `.mm .mm-sr-only` never applies to them: same rule, scoped here */
+html[data-reader] .mm-sr-only { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
+
+/* ============================================================ 2. typography of the article */
+html[data-reader] .doc article {
+  max-width: none; min-width: 0;
+  font-family: var(--font-prose); font-size: var(--rd-fs); line-height: var(--lh-prose); color: var(--ink);
+  font-kerning: normal; font-variant-ligatures: common-ligatures; text-rendering: optimizeLegibility; overflow-wrap: break-word;
+}
+html[data-reader][data-reader-font="sans"] .doc article { font-family: var(--font-ui); line-height: 1.65; }
+
+/* text blocks keep the reading measure and sit in the middle of the track; wide things (tables, code, footer) do not */
+html[data-reader] .doc article > :is(p, ul, ol, dl, blockquote, h1, h2, h3, h4, h5, h6, hr) { max-width: var(--rd-measure); margin-inline: auto; }
+
+html[data-reader] .doc article p { margin-top: 0; margin-bottom: 1.05em; }
+html[data-reader] .doc article > :first-child { margin-top: 0; }
+html[data-reader] .doc article strong, html[data-reader] .doc article b { font-weight: 700; }
+
+/* justified + hyphenated paragraphs: desktop, serif only, and only direct paragraphs (never lists, tables, callouts, code) */
+@media (min-width: 900px) {
+  html[data-reader]:not([data-reader-font="sans"]) .doc article > p:not(.rd-callout) { text-align: justify; text-justify: inter-word; hyphens: auto; -webkit-hyphens: auto; }
+}
