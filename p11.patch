+        self.assertFalse(notes.glob_match(g, "m2c/src/m2c/tui/run.py"))
+        self.assertTrue(notes.glob_match("backend/eo/{a,b}.py", "backend/eo/b.py"))
+
+    def test_dots_are_literal(self):
+        self.assertFalse(notes.glob_match("a.py", "axpy"))
+
