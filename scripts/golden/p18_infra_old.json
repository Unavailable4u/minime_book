 "ci_jobs": [
  {
   "name": "test",
   "steps": [
    "actions/checkout",
    "actions/setup-python",
    "pip install -r requirements.txt",
    "Backend tests (unit, integration, static)",
    "Skip gate (backend)"
   ]
  },
  {
   "name": "lint",
   "steps": [
    "actions/checkout",
    "actions/setup-python",
    "pip install ruff==0.17.1",
    "ruff check ."
   ]
  },
  {
   "name": "daemon-test",
   "steps": [
    "actions/checkout",
    "actions/setup-python",
    "pip install -r daemon/requirements.txt",
    "pytest daemon/tests -v"
   ]
  },
  {
   "name": "m2c-test",
   "steps": [
    "actions/checkout",
    "actions/setup-python",
    "Install ripgrep and bubblewrap (the tests that use the real tools skip",
    "Probe whether bubblewrap can start on this runner",
    "pip install -e \".[dev]\"",
    "Install the protocol schema libraries (jsonschema), pinned from protoc",
    "Tests",
    "Skip gate (m2c)",
    "m2c --version",
    "m2c doctor"
   ]
  },
  {
   "name": "frontend-lint",
   "steps": [
    "actions/checkout",
    "actions/setup-node",
    "npm ci",
    "CI=true npm run lint"
   ]
  },
  {
   "name": "frontend-test",
   "steps": [
    "actions/checkout",
    "actions/setup-node",
    "npm ci",
    "npm test"
   ]
  },
  {
   "name": "protocol",
   "steps": [
    "actions/checkout",
    "actions/setup-python",
    "pip install -r protocol/requirements.txt",
    "python protocol/validate.py",
    "Client copy of the schemas exists and is current",
    "Contract test",
    "Test the skip gate itself",
    "Skip gate (protocol)"
   ]
  },
  {
   "name": "canary",
   "steps": [
    "actions/checkout",
    "actions/setup-python",
    "Install the backend requirements",
    "Install the m2c client without its dependencies (its rich and prompt_t",
    "pip check (only m2c's own rich and prompt_toolkit lines are expected)",
    "Canary test, fake-recorder mode (no database)",
    "Skip gate (canary, fake-recorder mode)",
    "Scratch database (roles, auth stub, every migration in order)",
    "Canary test, real-database mode",
    "Skip gate (canary, real-database mode)"
   ]
  },
  {
   "name": "secrets-scan",
   "steps": [
    "actions/checkout",
    "gitleaks/gitleaks-action",
    "pip install semgrep",
    "semgrep scan --config=auto --sarif --output=semgre",
    "github/codeql-action/upload-sarif",
    "advanced-security/dismiss-alerts"
   ]
  },
  {
   "name": "promptfoo",
   "steps": [
    "actions/checkout",
    "actions/setup-python",
    "Install backend Python deps (role_provider.py imports eo/agents/utils)",
    "actions/setup-node",
    "npm ci",
    "Ensure promptfoo's configured env file exists (empty -- CI exports var",
    "Run Role Library promptfoo evals",
    "Run output_organizer promptfoo evals"
   ]
  }
 ],
