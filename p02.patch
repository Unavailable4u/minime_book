+/* MiniMe Atlas 2 - shell (P02): sidebar, top bar, breadcrumbs, palette, and the layout rules that make the
+   old pages sit correctly next to them. Loaded LAST on every converted page (after the page's own inline CSS), so
+   these rules win by order; where a selector would tie with an old one it is made more specific on purpose.
+   Uses tokens only. Built by assets/js/shell.js from content/nav.json. The old per-page CSS goes away page by page in P23. */
+
+/* ============================================================ 1. legacy token bridge
+   The old pages style themselves with --p, --p2, --ln, --tx, --dim, --r, --v, --a, --g, --m. Pointing them at the new
+   tokens gives byte-identical colours in Dark and lets the Paper theme reach the old pages. */
+:root {
+  --p: var(--panel);
+  --p2: var(--panel-2);
+  --ln: var(--line);
+  --tx: var(--ink);
+  --dim: var(--ink-dim);
+  --r: var(--brand);
+  --v: var(--graph);
+  --a: var(--gate);
+  --g: var(--ok);
+  --m: var(--pink);
+}
+
+/* ============================================================ 2. page layout next to the shell
+   html[data-sidebar] is set before first paint by the inline snippet in <head>: open | collapsed | drawer. */
+html { scroll-padding-top: calc(var(--topbar-h) + 12px); }
+html[data-sidebar] { --sb-w: var(--sbw); }
+html[data-sidebar="collapsed"] { --sb-w: var(--sbw-rail); }
+html[data-sidebar="drawer"] { --sb-w: 0px; }
+html[data-layout="bare"][data-sidebar] { --sb-w: 0px; }          /* bare pages have a slim top bar and no sidebar */
+
+/* beats the old `body{display:flex}` and the old mobile `body{padding-top:54px}` by specificity */
+html[data-sidebar] body { padding-left: var(--sb-w); padding-top: 0; transition: padding-left var(--dur-2) var(--ease); }
+html[data-sidebar] body > main { margin-top: calc(var(--topbar-h) + env(safe-area-inset-top, 0px)); }
+
+/* the chapter table of contents is sticky: keep it below the top bar (the old mobile drawer rules are !important and still win <= 900px) */
+html[data-sidebar] .toc { top: calc(var(--topbar-h) + 16px); max-height: calc(100vh - var(--topbar-h) - 32px); }
+
+/* tables whose header sticks to the page (not to a scroll box of their own) must stop below the top bar; shell.js adds the class */
+html[data-sidebar] .mm-vsticky th { top: calc(var(--topbar-h) + env(safe-area-inset-top, 0px)); }
+
+/* the reading-progress bar of the chapters rides on the top edge, beside the sidebar rather than over it */
+html[data-sidebar] .bk-progress { left: var(--sb-w); z-index: calc(var(--z-topbar) + 1); }
+
+/* the built-stamp line of the old nav: hidden in place, shell.js moves it into the sidebar footer */
+html[data-sidebar] body > .mm-built { display: none; }
+
+/* until shell.js has built the sidebar and top bar, paint their empty frames so the page does not jump */
+html[data-sidebar]:not([data-shell])::before { content: ""; position: fixed; z-index: var(--z-sidebar); top: 0; bottom: 0; left: 0; width: var(--sb-w);
+  background: var(--bg); border-right: 1px solid var(--line); animation: mm-ph 0s linear 2s forwards; }
+html[data-sidebar]:not([data-shell])::after { content: ""; position: fixed; z-index: var(--z-topbar); top: 0; left: var(--sb-w); right: 0; height: var(--topbar-h);
+  background: var(--bg); border-bottom: 1px solid var(--line); animation: mm-ph 0s linear 2s forwards; }
+@keyframes mm-ph { to { visibility: hidden; } }
+
+/* ============================================================ 3. sidebar */
+.mm-sb, .mm-top, .mm-pal, .mm-scrim, .mm-btt, .mm-skipnav { font-family: var(--font-ui); font-size: var(--fs-sm); line-height: var(--lh-ui); color: var(--ink); }
+.mm-sb *, .mm-top *, .mm-pal *, .mm-btt { box-sizing: border-box; }
+
+.mm-sb { position: fixed; z-index: var(--z-sidebar); top: 0; bottom: 0; left: 0; width: var(--sbw); display: flex; flex-direction: column;
+  padding: 0; background: var(--bg); border-right: 1px solid var(--line); overflow: hidden;
+  transition: width var(--dur-2) var(--ease), transform var(--dur-2) var(--ease), box-shadow var(--dur-2) var(--ease); }
+.mm-sb ul { list-style: none; margin: 0; padding: 0; }
+.mm-sb li + li { margin-top: 0; }
+
+.mm-sb__head { display: flex; align-items: center; justify-content: space-between; gap: var(--space-2); flex: none; min-height: calc(var(--topbar-h) + env(safe-area-inset-top, 0px));
+  padding: env(safe-area-inset-top, 0px) var(--space-3) 0 var(--space-3); border-bottom: 1px solid var(--line); }
+.mm-sb .mm-sb__brand { display: flex; align-items: center; gap: var(--space-3); min-width: 0; color: var(--ink); text-decoration: none; font-weight: 700; font-size: var(--fs-md); letter-spacing: -0.01em; white-space: nowrap; }
+.mm-sb__brand b { color: var(--brand); }
+.mm-sb__mark { flex: none; width: 24px; height: 24px; border-radius: var(--radius-2); display: grid; place-items: center; background: var(--brand); color: var(--on-brand); font-size: var(--fs-sm); font-weight: 700; }
+
+.mm-sb .mm-sb__jump { flex: none; display: flex; align-items: center; gap: var(--space-2); margin: var(--space-3) var(--space-3) var(--space-2); padding: 0 var(--space-3); min-height: 34px;
+  background: var(--panel-2); color: var(--ink-dim); border: 1px solid var(--line); border-radius: var(--radius-2); font: inherit; cursor: pointer; text-align: left; }
+.mm-sb .mm-sb__jump:hover { border-color: var(--brand); color: var(--ink); }
+.mm-sb__jump-i { display: inline-flex; flex: none; }
+.mm-sb__jump-t { flex: 1; min-width: 0; white-space: nowrap; }
+.mm-sb kbd, .mm-top kbd, .mm-pal kbd { font-family: var(--font-mono); font-size: var(--fs-xs); background: var(--bg); color: var(--ink-dim); border: 1px solid var(--line); border-radius: var(--radius-1); padding: 0 var(--space-1); white-space: nowrap; }
+
+.mm-sb__scroll { flex: 1; min-height: 0; overflow-y: auto; overscroll-behavior: contain; padding: var(--space-2) 0 var(--space-4); scrollbar-width: thin; scrollbar-color: var(--line-strong) transparent; }
+
+.mm-wing + .mm-wing { margin-top: var(--space-2); }
+.mm-sb .mm-wing__h { display: flex; align-items: center; gap: var(--space-3); width: 100%; min-height: 34px; padding: 0 var(--space-3) 0 14px; background: none; border: 0; border-radius: 0;
+  color: var(--ink-dim); font: inherit; font-size: var(--fs-xs); font-weight: 600; letter-spacing: 0.09em; text-transform: uppercase; text-align: left; cursor: pointer; }
+.mm-sb .mm-wing__h:hover { color: var(--ink); background: none; border-color: transparent; }
+.mm-wing.is-active > .mm-wing__h { color: var(--ink); }
+.mm-wing__i { display: inline-flex; flex: none; }
+.mm-wing.is-active .mm-wing__i { color: var(--brand); }
+.mm-wing__t { flex: 1; min-width: 0; white-space: nowrap; }
+.mm-wing__chev { display: inline-flex; flex: none; transition: transform var(--dur-1) var(--ease); }
+.mm-wing__chev svg { width: 14px; height: 14px; }
+.mm-wing__h[aria-expanded="true"] .mm-wing__chev { transform: rotate(90deg); }
+.mm-wing__list[hidden] { display: none; }
+
+.mm-sb a.mm-it { display: flex; align-items: center; gap: var(--space-2); min-height: 32px; margin: 1px var(--space-2) 1px var(--space-2); padding: 4px var(--space-3) 4px 34px; border-radius: var(--radius-2);
+  color: var(--ink-dim); text-decoration: none; font-size: var(--fs-sm); }
+.mm-sb a.mm-it:hover { background: var(--panel-2); color: var(--ink); }
+.mm-sb a.mm-it.is-active { background: color-mix(in srgb, var(--brand) 14%, transparent); color: var(--ink); box-shadow: inset 2px 0 var(--brand); }
+.mm-it__t { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.mm-it__n { flex: none; min-width: 1.7em; padding: 0 var(--space-1); text-align: center; font-family: var(--font-mono); font-size: var(--fs-xs); color: var(--ink-dim); border: 1px solid var(--line); border-radius: var(--radius-1); }
+.mm-it.is-active .mm-it__n { border-color: var(--brand); color: var(--ink); }
+.mm-it__c { flex: none; margin-left: auto; font-family: var(--font-mono); font-size: var(--fs-xs); color: var(--ink-dim); font-variant-numeric: tabular-nums; }
+.mm-part { margin: var(--space-2) 0 2px; padding: 0 var(--space-4) 0 34px; font-size: var(--fs-xs); color: var(--ink-dim); opacity: 0.85; }
+
+.mm-sb__foot { flex: none; display: flex; flex-direction: column; gap: 2px; padding: var(--space-3) var(--space-4) calc(var(--space-3) + env(safe-area-inset-bottom, 0px)); border-top: 1px solid var(--line); font-size: var(--fs-xs); color: var(--ink-dim); }
+.mm-sb__err { margin: var(--space-3) var(--space-4); font-size: var(--fs-xs); color: var(--gate); }
+
+/* --- rail (collapsed): icons only; hover, focus or a tap on an icon peeks the full sidebar over the page */
+html[data-sidebar="collapsed"] .mm-sb { width: var(--sbw-rail); }
+html[data-sidebar="collapsed"] .mm-sb:is(:hover, :focus-within, .is-peek) { width: var(--sbw); box-shadow: var(--shadow-3); transition-delay: 0.12s, 0s, 0.12s; }
+html[data-sidebar="collapsed"] .mm-sb:not(:hover, :focus-within, .is-peek) :is(.mm-sb__brand-t, .mm-sb__jump-t, .mm-sb kbd, .mm-wing__t, .mm-wing__chev, .mm-wing__list, .mm-sb__foot, .mm-sb__collapse) { display: none; }
+html[data-sidebar="collapsed"] .mm-sb:not(:hover, :focus-within, .is-peek) .mm-sb__head { justify-content: center; padding-inline: 0; }
+html[data-sidebar="collapsed"] .mm-sb:not(:hover, :focus-within, .is-peek) .mm-sb__jump { justify-content: center; margin-inline: var(--space-2); padding: 0; }
+html[data-sidebar="collapsed"] .mm-sb:not(:hover, :focus-within, .is-peek) .mm-wing__h { justify-content: center; padding: 0; }
+
+/* --- drawer (<= 760px): off-canvas, above the scrim; hidden from keyboard and screen readers while closed */
+html[data-sidebar="drawer"] .mm-sb { width: min(var(--sbw), 86vw); z-index: calc(var(--z-modal) + 1); transform: translateX(-105%); visibility: hidden; box-shadow: none;
+  transition: transform var(--dur-2) var(--ease), visibility 0s linear var(--dur-2); }
+html[data-sidebar="drawer"][data-drawer="open"] .mm-sb { transform: none; visibility: visible; box-shadow: var(--shadow-3); transition: transform var(--dur-2) var(--ease), visibility 0s; }
+html[data-layout="bare"] .mm-sb { display: none; }
+
+/* ============================================================ 4. top bar and breadcrumbs */
+.mm-top { position: fixed; z-index: var(--z-topbar); top: 0; left: var(--sb-w, 0px); right: 0; display: flex; align-items: center; gap: var(--space-3);
+  height: calc(var(--topbar-h) + env(safe-area-inset-top, 0px)); padding: env(safe-area-inset-top, 0px) max(var(--space-4), env(safe-area-inset-right, 0px)) 0 var(--space-3);
+  background: var(--bg); border-bottom: 1px solid var(--line); transition: left var(--dur-2) var(--ease); }
+.mm-top__sp { flex: 1; }
+
+.mm-top .mm-ib, .mm-sb .mm-ib { display: inline-flex; align-items: center; justify-content: center; flex: none; width: 36px; height: 36px; padding: 0; background: transparent; color: var(--ink-dim);
+  border: 1px solid transparent; border-radius: var(--radius-2); font: inherit; cursor: pointer; }
+.mm-top .mm-ib:hover, .mm-sb .mm-ib:hover { background: var(--panel-2); color: var(--ink); border-color: var(--line); }
+html[data-layout="bare"] .mm-top__menu { display: none; }
+
+.mm-crumbs { min-width: 0; flex: 0 1 auto; overflow: hidden; }
+.mm-crumbs__l { display: flex; align-items: center; min-width: 0; margin: 0; padding: 0; list-style: none; white-space: nowrap; font-size: var(--fs-sm); color: var(--ink-dim); }
+.mm-crumbs__l li { flex: none; margin: 0; }
+.mm-crumbs__l li:last-child { flex: 0 1 auto; min-width: 0; overflow: hidden; text-overflow: ellipsis; color: var(--ink); font-weight: 600; }
+.mm-crumbs__l li + li::before { content: "\203A"; margin: 0 0.55em; color: var(--ink-dim); }
+.mm-crumbs__l a { color: var(--ink-dim); text-decoration: none; display: inline-flex; align-items: center; gap: var(--space-1); }
+.mm-crumbs__l a:hover { color: var(--ink); text-decoration: underline; }
+
+.mm-chip { display: inline-flex; align-items: center; gap: var(--space-1); flex: none; padding: 2px var(--space-3); border: 1px solid var(--line); border-radius: var(--radius-pill); font-size: var(--fs-xs); color: var(--ink-dim); white-space: nowrap; }
+.mm-chip code { font-family: var(--font-mono); font-size: var(--fs-xs); background: none; border: 0; padding: 0; color: var(--ok); }
+
+.mm-top .mm-top__k, .mm-top .mm-top__toc { display: inline-flex; align-items: center; gap: var(--space-2); flex: none; min-height: 34px; padding: 0 var(--space-3); background: var(--panel-2); color: var(--ink-dim);
+  border: 1px solid var(--line); border-radius: var(--radius-2); font: inherit; font-size: var(--fs-sm); cursor: pointer; }
+.mm-top .mm-top__k:hover, .mm-top .mm-top__toc:hover { border-color: var(--brand); color: var(--ink); }
+.mm-top .mm-top__toc { display: none; }
+
+/* ============================================================ 5. scrim, palette, back to top, skip link */
+.mm-scrim { position: fixed; inset: 0; z-index: var(--z-modal); background: var(--scrim); opacity: 0; pointer-events: none; transition: opacity var(--dur-2) var(--ease); }
+html[data-drawer="open"] .mm-scrim { opacity: 1; pointer-events: auto; }
+body.toc-open .mm-scrim { opacity: 1; pointer-events: auto; z-index: 1002; }      /* under the old mobile .toc drawer (z-index 1003) */
+
+.mm-pal { position: fixed; inset: 0; z-index: var(--z-modal); display: flex; align-items: flex-start; justify-content: center;
+  padding: max(8vh, env(safe-area-inset-top, 0px)) var(--space-4) var(--space-5); background: var(--scrim); backdrop-filter: blur(3px); }
+.mm-pal[hidden] { display: none; }
+.mm-pal__box { width: 100%; max-width: 640px; max-height: 80vh; display: flex; flex-direction: column; background: var(--panel); border: 1px solid var(--line-strong); border-radius: var(--radius-3); box-shadow: var(--shadow-3); overflow: hidden; }
+.mm-pal__top { display: flex; align-items: center; gap: var(--space-3); padding: var(--space-2) var(--space-4); background: var(--panel-2); border-bottom: 1px solid var(--line); color: var(--ink-dim); }
+.mm-pal__top:focus-within { box-shadow: inset 0 -2px 0 var(--focus); }
+.mm-pal .mm-pal__in { flex: 1; min-width: 0; width: auto; padding: var(--space-2) 0; background: transparent; border: 0; border-radius: 0; color: var(--ink); font: inherit; font-size: var(--fs-md); outline: none; }
+.mm-pal .mm-pal__in::placeholder { color: var(--ink-dim); }
+.mm-pal .mm-pal__esc { padding: 2px var(--space-2); background: var(--bg); color: var(--ink-dim); border: 1px solid var(--line); border-radius: var(--radius-1); font: inherit; font-size: var(--fs-xs); cursor: pointer; }
+.mm-pal__list { overflow-y: auto; padding: var(--space-2); }
+.mm-pal__g { padding: var(--space-3) var(--space-3) var(--space-1); font-size: var(--fs-xs); letter-spacing: 0.09em; text-transform: uppercase; color: var(--ink-dim); }
+.mm-pal a.mm-pal__r { display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); padding: var(--space-2) var(--space-3); border-radius: var(--radius-2); color: var(--ink); text-decoration: none; }
+.mm-pal a.mm-pal__r[aria-selected="true"] { background: var(--panel-2); box-shadow: inset 2px 0 var(--brand); }
+.mm-pal__rt { min-width: 0; }
+.mm-pal__rt b { display: block; font-weight: 600; font-size: var(--fs-sm); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.mm-pal__rt small { display: block; font-size: var(--fs-xs); color: var(--ink-dim); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.mm-pal__pill { flex: none; padding: 1px var(--space-2); border: 1px solid var(--line); border-radius: var(--radius-pill); font-size: var(--fs-xs); color: var(--ink-dim); white-space: nowrap; }
+.mm-pal__none { padding: var(--space-4); color: var(--ink-dim); }
+.mm-pal__none a { color: var(--brand); }
+
+.mm-btt { position: fixed; right: max(18px, env(safe-area-inset-right, 0px)); bottom: max(18px, env(safe-area-inset-bottom, 0px)); z-index: var(--z-sticky); width: 38px; height: 38px; padding: 0;
+  display: inline-flex; align-items: center; justify-content: center; background: var(--brand); color: var(--on-brand); border: 0; border-radius: 50%; box-shadow: var(--shadow-2);
+  cursor: pointer; opacity: 0; pointer-events: none; transition: opacity var(--dur-2) var(--ease); }
+.mm-btt.is-on { opacity: 1; pointer-events: auto; }
+
+.mm-skipnav { position: fixed; left: var(--space-3); top: -4rem; z-index: var(--z-toast); padding: var(--space-2) var(--space-4); background: var(--brand); color: var(--on-brand); border-radius: var(--radius-2); font-weight: 600; text-decoration: none; }
+.mm-skipnav:focus { top: calc(var(--space-3) + env(safe-area-inset-top, 0px)); }
+
+.mm-sb :focus-visible, .mm-top :focus-visible, .mm-pal :focus-visible, .mm-btt:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
+.mm-sb :focus-visible { outline-offset: -2px; }
+
+/* ============================================================ 6. narrow screens */
+@media (max-width: 1099px) { .mm-chip { display: none; } }
+@media (max-width: 900px) {
+  .mm-top .mm-top__toc { display: inline-flex; }                    /* the old mobile CSS turns .toc into a drawer at this width */
+}
+@media (max-width: 760px) {
+  .mm-top { padding-left: var(--space-2); gap: var(--space-2); }
+  .mm-crumbs__l li:not(:last-child) { display: none; }
+  .mm-crumbs__l li + li::before { content: none; }
+  .mm-top .mm-top__k { padding: 0; width: 36px; justify-content: center; }
+  .mm-top__k-t, .mm-top .mm-top__k kbd, .mm-top__toc-t { display: none; }
+  .mm-top .mm-top__toc { padding: 0; width: 36px; justify-content: center; }
+}
+
+/* ============================================================ 7. Paper theme on pages that still carry their own colours
+   Old inline CSS hard-codes light text colours (#fff, #ff7a96, #ffb3c2, #c4b5fd, #fbbf24) that are unreadable on Paper.
+   :where() keeps these as weak as the old rules, so they win only by coming later. Temporary: removed page by page in P23. */
+:where([data-theme="paper"]) a { color: var(--brand); }
+:where([data-theme="paper"]) code { color: var(--brand); }
+:where([data-theme="paper"]) :is(.k, .bk-ch, .bk-fcard b, .toc a:hover, .bk-pill-link:hover, .bk-nav-btn:hover, .con-btn.on, .con-btn:hover, .bk-fbtn:hover, .bk-fbtn.on, .tb-fbtn.on) { color: var(--ink); }
+:where([data-theme="paper"]) :is(.bk-part, .bk-fcard span, .toc a.active-sec, .bk-nav-btn.bk-next, .st-rem) { color: var(--brand); }
+:where([data-theme="paper"]) :is(.bk-sync, .st-plan) { color: var(--graph); }
+:where([data-theme="paper"]) :is(.bk-override-box h3, .st-part) { color: var(--gate); }
+:where([data-theme="paper"]) .bk-banner { background: linear-gradient(180deg, color-mix(in srgb, var(--brand) 8%, transparent), var(--panel)); }
+:where([data-theme="paper"]) .bk-fcard.bk-fnext { background: linear-gradient(135deg, var(--panel), color-mix(in srgb, var(--brand) 8%, transparent)); }
+@media (max-width: 900px) { [data-theme="paper"] .toc { background: var(--panel) !important; } }
+
+/* ============================================================ 8. print */
+@media print {
+  .mm-sb, .mm-top, .mm-scrim, .mm-btt, .mm-skipnav, .mm-pal { display: none !important; }
+  html[data-sidebar] body { padding-left: 0; }
+  html[data-sidebar] body > main { margin-top: 0; }
+}
