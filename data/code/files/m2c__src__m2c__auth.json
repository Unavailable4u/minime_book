2c/src/m2c/auth/credentials.py::load_credential"],["_server_for","m2c/src/m2c/auth/login.py::_server_for"],["_cache_key","m2c/src/m2c/auth/login.py::_cache_key"],["_post","m2c/src/m2c/auth/login.py::_post"],["_clear_cache_locked","m2c/src/m2c/auth/login.py::_clear_cache_locked"],["log_event","m2c/src/m2c/logging_setup.py::log_event"],["_token_failure","m2c/src/m2c/auth/login.py::_token_failure"],["_parse_object","m2c/src/m2c/auth/login.py::_parse_object"],["_matches","m2c/src/m2c/auth/login.py::_matches"],["_is_int","m2c/src/m2c/auth/login.py::_is_int"],["AuthProtocolError","m2c/src/m2c/auth/credentials.py::AuthProtocolError"],["_CachedToken","m2c/src/m2c/auth/login.py::_CachedToken"]],"cc":15,"cc_deep":15,"code":37,"decorators":[],"doc":true,"doc1":"A valid device JWT, as a ``Secret`` (``.reveal()`` for the text).","end":789,"hash":"292c8114c7","kind":"function","loc":56,"name":"get_access_token","params":[{"annotation":"str | None","default":"None","kind":"kwonly","name":"server_url"},{"annotation":"Clock | None","default":"None","kind":"kwonly","name":"clock"},{"annotation":"float","default":"REQUEST_TIMEOUT","kind":"kwonly","name":"timeout"}],"qual":"get_access_token","raises":["_token_failure","AuthProtocolError"],"returns":"Secret","start":734,"test":false,"visibility":"public"}],"git":{"added":789,"commits":1,"dates":["2026-10-25"],"deleted":0,"first":"2026-10-25","last":"2026-10-25"},"lang":"python","lines":789,"module_doc":"m2c/src/m2c/auth/login.py -- Patch C03: ``m2c login``, ``m2c logout`` and the\naccess-token helper.\n\nTHE FLOW (OAuth device authorisation, RFC 8628; server side is S03,\nbackend/api/routes/devices.py and backend/eo/devices.py -- these are the exact\nshapes this module talks to)::\n\n    login(server_url)\n      POST /v1/code/devices/pair/start  {device_name, os, client_version}\n        -> {device_code (secret), user_code, verification_url, interval, expires_in}\n      print user_code and verification_url        (never opens a browser)\n      every `interval` seconds:\n        POST /v1/code/devices/pair/poll {device_code}\n          -> {status: pending}                     keep waiting\n             {status: approved, device_credential, device_id}   (ONCE)\n             {status: denied} | {status: expired}  stop, say so\n      store the credential (credentials.py), tell the person where\n\n    get_access_token()\n      POST /v1/code/devices/token {device_credential} -> {jwt, expires_in}\n      cached in memory, refreshed before it expires\n\nNo browser is launched: from WSL2, and from any ssh session, that usually\nfails, and the page works from any device anyway (build plan §11.1).\n\nPATIENCE AND LIMITS\n-------------------\n* The server's ``interval`` is honoured, clamped to 1..60 seconds, and the\n  first poll waits one interval (RFC 8628 §3.5).  ``expires_in`` is clamped to\n  30 minutes; S03 uses 10.\n* Temporary trouble -- a dropped connection, a 5xx, a 429, a reply that is not\n  JSON (a captive ","path":"m2c/src/m2c/auth/login.py","size":32521,"test":false}],"schema":1,"shard":"m2c__src__m2c__auth"}
