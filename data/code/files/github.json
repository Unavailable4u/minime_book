"cc_deep":1,"code":4,"decorators":["pytest.mark.parametrize('line', ['just a reason with no scope', 'm2c |"],"doc":false,"end":233,"hash":"f4301e7dbc","kind":"function","loc":4,"name":"test_a_malformed_allow_list_line_fails_instead_of_being_ignored","params":[{"name":"tmp_path"},{"name":"capsys"},{"name":"line"}],"qual":"test_a_malformed_allow_list_line_fails_instead_of_being_ignored","start":230,"test":true,"visibility":"public"},{"args":2,"async":false,"calls":[["run",".github/scripts/test_check_skips.py::run"]],"cc":1,"cc_deep":1,"code":6,"decorators":[],"doc":false,"end":243,"hash":"bffd4276ae","kind":"function","loc":8,"name":"test_comments_and_blank_lines_in_the_allow_list_are_ignored","params":[{"name":"tmp_path"},{"name":"capsys"}],"qual":"test_comments_and_blank_lines_in_the_allow_list_are_ignored","start":236,"test":true,"visibility":"public"},{"args":2,"async":false,"calls":[["junit",".github/scripts/test_check_skips.py::junit"],["allowlist",".github/scripts/test_check_skips.py::allowlist"]],"cc":1,"cc_deep":1,"code":6,"decorators":[],"doc":false,"end":251,"hash":"db4961c991","kind":"function","loc":6,"name":"test_several_reports_are_read_together","params":[{"name":"tmp_path"},{"name":"capsys"}],"qual":"test_several_reports_are_read_together","start":246,"test":true,"visibility":"public"},{"args":0,"async":false,"cc":2,"cc_deep":2,"code":6,"decorators":[],"doc":false,"end":262,"hash":"92f5f83246","kind":"function","loc":6,"name":"test_the_real_allow_list_parses_and_stays_short","params":[],"qual":"test_the_real_allow_list_parses_and_stays_short","start":257,"test":true,"visibility":"public"},{"args":0,"async":false,"cc":3,"cc_deep":3,"code":5,"decorators":[],"doc":true,"doc1":"ripgrep and jsonschema are installed by the job, so skipping for them is a failure.","end":270,"hash":"ca21292419","kind":"function","loc":6,"name":"test_the_real_allow_list_does_not_allow_the_skips_this_patch_exists_to_remove","params":[],"qual":"test_the_real_allow_list_does_not_allow_the_skips_this_patch_exists_to_remove","start":265,"test":true,"visibility":"public"}],"git":{"added":270,"commits":1,"dates":["2026-11-13"],"deleted":0,"first":"2026-11-13","last":"2026-11-13"},"lang":"python","lines":270,"module_doc":".github/scripts/test_check_skips.py -- Patch Q01: tests for the skip gate.\n\ncheck_skips.py is the CI step that turns \"a test was skipped\" from something a\nperson has to notice in a log into something that fails the job unless the\nreason is on the allow list kept next to it (skip-allowlist.txt).  A gate that\ncan never fail is worse than no gate, so these tests pin the behaviour that\nmatters: an unlisted reason FAILS, and so does every input that would let a\nproblem pass quietly (a missing or unreadable report, a run in which no test\nran at all, an allow-list line the script cannot understand).\n\nStandard library only, so it runs under the plain interpreter of any CI job:\n\n    python -m pytest .github/scripts -q          (from the repository root)\n\nNothing here builds a secret-shaped string; every value is plain prose.","path":".github/scripts/test_check_skips.py","size":10520,"test":true,"test_count":21},{"binary":false,"blank":11,"code":666,"comment":0,"ext":"yml","git":{"added":794,"commits":16,"dates":["2026-08-05","2026-08-05","2026-08-13","2026-08-13","2026-08-13","2026-08-13","2026-08-13","2026-08-24","2026-08-24","2026-08-25","2026-10-20","2026-10-24","2026-10-24","2026-11-13","2026-11-13","2026-11-14"],"deleted":117,"first":"2026-08-05","last":"2026-11-14"},"lang":"yaml","lines":677,"path":".github/workflows/ci.yml","size":39922,"test":false}],"schema":1,"shard":"github"}
