apping[str, str]","name":"environ"}],"qual":"is_allowed","returns":"Entry | None","start":120,"test":false,"visibility":"public"},{"args":2,"async":false,"calls":[["argparse.ArgumentParser",null],["load_allowlist",".github/scripts/check_skips.py::load_allowlist"],["Counter",null],["read_skips",".github/scripts/check_skips.py::read_skips"],["is_allowed",".github/scripts/check_skips.py::is_allowed"]],"cc":8,"cc_deep":8,"code":41,"decorators":[],"doc":false,"end":175,"hash":"e75a1c5fa3","kind":"function","loc":45,"name":"main","params":[{"annotation":"Sequence[str] | None","default":"None","name":"argv"},{"annotation":"Mapping[str, str] | None","default":"None","name":"environ"}],"qual":"main","returns":"int","start":131,"test":false,"visibility":"public"}],"git":{"added":179,"commits":1,"dates":["2026-11-13"],"deleted":0,"first":"2026-11-13","last":"2026-11-13"},"lang":"python","lines":179,"module_doc":".github/scripts/check_skips.py -- Patch Q01: fail a CI job on an unexpected skip.\n\nWhy this exists.  pytest reports a skipped test as neither a pass nor a\nfailure, so a suite can go green while a whole group of tests quietly stops\nrunning: the m2c job used to skip 3 schema-validation tests because\n``jsonschema`` was not installed, and would have skipped about 22 grep tests\non any runner without ripgrep, and nobody would have been told.  This script\nreads the JUnit XML report pytest writes (``--junitxml``), prints every skip\nreason with a count, and exits non-zero unless every reason is on the allow\nlist in ``skip-allowlist.txt`` (same directory).\n\nUsage (from a job, after pytest has written its report; the job must still\nrun this step when pytest failed or skipped, so use ``if: ${{ !cancelled() }}``):\n\n    python .github/scripts/check_skips.py --scope m2c report.xml [report2.xml ...]\n\nOptions:\n    --scope NAME       which allow-list entries apply: \"m2c\", \"backend\", or any\n                       name.  Entries whose scope is \"*\" always apply.\n    --allowlist FILE   default: skip-allowlist.txt next to this script.\n\nAllow-list format (one entry per line, ``#`` starts a comment):\n\n    scope | text that must appear in the skip reason [| when=ENV_VAR]\n\n``when=ENV_VAR`` makes the entry active only while that environment variable is\nexactly \"1\".  The m2c job uses it for the sandbox entry: the job probes whether\nbubblewrap can create a user namespace on the runner and sets the variabl","path":".github/scripts/check_skips.py","size":7547,"test":false},{"binary":false,"blank":2,"code":40,"comment":0,"ext":"txt","git":{"added":42,"commits":1,"dates":["2026-11-13"],"deleted":0,"first":"2026-11-13","last":"2026-11-13"},"lang":"text","lines":42,"path":".github/scripts/skip-allowlist.txt","size":2693,"test":false},{"binary":false,"blank":57,"code":177,"comment":36,"exports":["HERE","allowlist","check_skips","junit","run","test_a_conditional_entry_applies_when_its_variable_is_1","test_a_conditional_entry_is_ignored_when_its_variable_is_not_set","test_a_conditional_entry_needs_exactly_1","test_a_listed_reason_is_matched_as_a_substring_of_the_real_one","test_a_listed_skip_passes_but_is_still_printed","test_a_malformed_allow_list_line_fails_instead_of_being_ignored","test_a_missing_allow_list_fails","test_a_missing_report_fails","test_a_run_in_which_no_test_ran_fails","test_a_run_with_no_skips_passes","test_a_skip_that_is_not_on_the_list_fails_and_names_its_reason","test_a_star_scope_applies_everywhere","test_an_entry_for_another_scope_does_not_apply","test_an_expected_failure_is_not_a_skip","test_an_unreadable_report_fails","test_comments_and_blank_lines_in_the_allow_list_are_ignored","test_one_unlisted_reason_among_listed_ones_still_fails","test_several_reports_are_read_together","test_several_skips_with_one_reason_are_counted_together","test_the_real_allow_list_does_not_allow_the_skips_this_patch_exists_to_remove","test_the_real_allow_list_parses_and_stays_short"],"ext":"py","functions":[{"args":3,"async":false,