lls every run.\nFirst run needs a real GROQ_API_KEY to record; every run after that\nreplays the cassette and needs no key and no network call at all.\n\nUsage:\n    # first time (or to refresh a stale cassette):\n    GROQ_API_KEY=your_key_here pytest tests/manual/test_tool_calling.py -v -s\n    # every run after that -- no key needed, replays the cassette:","path":"backend/tests/manual/test_tool_calling.py","size":18674,"test":true,"test_count":1},{"binary":false,"blank":6,"code":19,"comment":7,"exports":["pytestmark","test_upstash_set_and_get_round_trip"],"ext":"py","functions":[{"args":0,"async":false,"calls":[["Redis",null],["os.getenv",null]],"cc":2,"cc_deep":2,"code":9,"decorators":["pytest.mark.skipif(not (os.getenv('UPSTASH_REDIS_REST_URL') and os.get"],"doc":false,"end":32,"hash":"4dcaddc6a1","kind":"function","loc":10,"name":"test_upstash_set_and_get_round_trip","params":[],"qual":"test_upstash_set_and_get_round_trip","start":23,"test":true,"visibility":"public"}],"git":{"added":32,"commits":1,"dates":["2026-08-05"],"deleted":0,"first":"2026-08-05","last":"2026-08-05"},"lang":"python","lines":32,"module_doc":"tests/manual/test_upstash.py — moved from tests/test_upstash.py (B1\nmanual-tier migration). Hits the real Upstash Redis REST endpoint with\nUPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN; not run in CI. Note\nthis package's conftest.py disables the autouse fake_bus fixture for\nexactly this reason -- this test wants the real Redis, not FakeRedis.","path":"backend/tests/manual/test_upstash.py","size":1012,"test":true,"test_count":1}],"schema":1,"shard":"backend__tests__manual"}
