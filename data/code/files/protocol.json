_files"]],"cc":6,"cc_deep":6,"code":15,"decorators":[],"doc":true,"doc1":"Byte-for-byte comparison of the client's synced copy with protocol/v1.","end":582,"hash":"f96edc6567","kind":"function","loc":21,"name":"compare_client_copy","params":[{"annotation":"Path","default":"CLIENT_COPY_DIR","name":"client_dir"},{"annotation":"Path","default":"V1_DIR","name":"source_dir"}],"qual":"compare_client_copy","returns":"list[str]","start":562,"test":false,"visibility":"public"},{"args":2,"async":false,"calls":[["_json_files","protocol/validate.py::_json_files"],["Path",null],["shutil.copyfile",null]],"cc":2,"cc_deep":2,"code":8,"decorators":[],"doc":true,"doc1":"Copy every *.json under src to dst, byte for byte.","end":594,"hash":"d6b8b9305d","kind":"function","loc":10,"name":"copy_tree","params":[{"annotation":"Path","name":"src"},{"annotation":"Path","name":"dst"}],"qual":"copy_tree","returns":"list[str]","start":585,"test":false,"visibility":"public"},{"args":2,"async":false,"calls":[["Path",null],["_json_files","protocol/validate.py::_json_files"],["copy_tree","protocol/validate.py::copy_tree"]],"cc":5,"cc_deep":5,"code":13,"decorators":[],"doc":true,"doc1":"Make <client_pkg_dir>/protocol/v1 a byte-identical mirror of the schemas.","end":615,"hash":"8316ba8f36","kind":"function","loc":19,"name":"sync_client","params":[{"annotation":"Path","default":"CLIENT_PKG_DIR","name":"client_pkg_dir"},{"annotation":"Path","default":"V1_DIR","name":"source_dir"}],"qual":"sync_client","raises":["FileNotFoundError"],"returns":"list[str]","start":597,"test":false,"visibility":"public"},{"args":3,"async":false,"cc":4,"cc_deep":4,"code":10,"decorators":[],"doc":false,"end":631,"hash":"bdd608cbf3","kind":"function","loc":10,"name":"_report","params":[{"annotation":"str","name":"title"},{"annotation":"list[str]","name":"problems"},{"annotation":"str","default":"''","name":"hint"}],"qual":"_report","returns":"bool","start":622,"test":false,"visibility":"private"},{"args":1,"async":false,"calls":[["argparse.ArgumentParser",null],["sync_client","protocol/validate.py::sync_client"],["_report","protocol/validate.py::_report"],["compare_client_copy","protocol/validate.py::compare_client_copy"],["iter_v1_documents","protocol/validate.py::iter_v1_documents"],["load_tools","protocol/validate.py::load_tools"],["message_types","protocol/validate.py::message_types"],["check_schemas","protocol/validate.py::check_schemas"],["check_fixtures","protocol/validate.py::check_fixtures"],["load_jsonl","protocol/validate.py::load_jsonl"],["check_invalid_examples","protocol/validate.py::check_invalid_examples"]],"cc":13,"cc_deep":13,"code":39,"decorators":[],"doc":false,"end":675,"hash":"e26bcef9ac","kind":"function","loc":42,"name":"main","params":[{"annotation":"list[str] | None","default":"None","name":"argv"}],"qual":"main","returns":"int","start":634,"test":false,"visibility":"public"}],"git":{"added":679,"commits":1,"dates":["2026-10-24"],"deleted":0,"first":"2026-10-24","last":"2026-10-24"},"lang":"python","lines":679,"module_doc":"Patch P00 (M2C Wave 1) -- validator for the M2C protocol and tool-schema contract.\n\nprotocol/v1/ is the ONE source of truth for the wire format between the device\nclient (m2c/) and the server (backend/codeagent/, WP S04/S05/S09). This script\nis the reference reader of it:\n\n    python protocol/validate.py                    # everything below, exit 0/1\n    python protocol/validate.py --check-client-copy\n    python protocol/validate.py --sync-client\n\nDefault run checks, in order:\n  1. every schema under protocol/v1 is a well-formed Draft 2020-12 schema whose\n     $id matches its path, every $ref resolves, every tool definition fits\n     tool_definition.json, and every v0 tool has a tool_proposed branch;\n  2. every golden transcript (protocol/fixtures/*.jsonl) validates line by line\n     AND as a transcript (check_transcript: seq runs, call-id pairing, resume\n     cursors, terminal states);\n  3. every case in fixtures/invalid_examples.jsonl FAILS, and fails on the\n     keyword and path it names (so a broken example cannot pass for the wrong\n     reason);\n  4. the client's synced copy of the schemas, if the m2c/ package exists yet,\n     is byte-identical (see compare_client_copy).\n\n--check-client-copy runs only step 4. It passes when m2c/src/m2c/protocol/v1/\ndoes not exist yet: WP C01 creates the client package in parallel with this\npatch, so on a tree without it there is nothing to compare.\n\n--sync-client copies protocol/v1/**/*.json over the client copy (and removes\nstale .json","path":"protocol/validate.py","size":28662,"test":false}],"schema":1,"shard":"protocol"}
