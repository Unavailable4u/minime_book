ace_from_a_dock_dispatched_run","start":148,"test":true,"visibility":"public"},{"args":2,"async":false,"calls":[["slugify","backend/memory/bus.py::slugify"],["set_app_slug","backend/memory/bus.py::set_app_slug"],["write","backend/memory/bus.py::write"],["_full_url","backend/tests/unit/test_task_routes_full_payload.py::_full_url"]],"cc":1,"cc_deep":1,"code":10,"decorators":["pytest.mark.xfail(reason=\"Same underlying finding as the dock-dispatch"],"doc":false,"end":189,"hash":"92cc9e3c0c","kind":"function","loc":13,"name":"test_route_misses_the_real_write_namespace_from_a_no_app_slug_run","params":[{"name":"client"},{"name":"fake_bus"}],"qual":"test_route_misses_the_real_write_namespace_from_a_no_app_slug_run","start":177,"test":true,"visibility":"public"}],"git":{"added":190,"commits":2,"dates":["2026-08-26","2026-10-20"],"deleted":1,"first":"2026-08-26","last":"2026-10-20"},"lang":"python","lines":189,"module_doc":"tests/unit/test_task_routes_full_payload.py — J.4 coverage for J.2,\nGET /api/task/{session_id}/step/{role}/full (backend/api/routes/tasks.py).\n\nMounts just this one route on a throwaway FastAPI app (same pattern as\ntests/unit/test_eo_local_workspace.py's websocket tests) and overrides\nrequire_auth, since real auth is Supabase-JWT-backed and out of scope\nfor this route's own contract.\n\nIMPORTANT FINDING (read below before assuming this route is fully\nfixed): the two straightforward tests below match the guide's literal\nJ.2 \"Done when\" wording — 200 for a completed step, 404 for a\nnonexistent one — and both pass. But a third test,\ntest_route_misses_the_real_write_namespace_from_a_dock_dispatched_run,\nreproduces how a real tier-3 run actually scopes its stage_output\nwrite (per api/task_runner.py's set_app_slug() call and\nWorkspaceDockContext.jsx's \"BUGFIX (bug audit, patch 5)\" comment: the\nwrite happens under app_slug = the dock's real workspace id, or —\nfor a non-dock/no-app_slug caller — under\nf\"{slugify(task_text)}_{session_id[:8]}